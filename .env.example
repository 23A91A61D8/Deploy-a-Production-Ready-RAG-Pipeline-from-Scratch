# =============================================================
# RAG Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control!
# =============================================================

# ----- OpenAI Configuration -----
# Your OpenAI API key (required for openai embedding and LLM backends)
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM model used for answer generation
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
LLM_MODEL=gpt-4o-mini

# ----- Embedding Configuration -----
# Backend to use for generating embeddings
# Options: openai | huggingface
EMBEDDING_BACKEND=openai

# Embedding model name (auto-selected based on backend if not set)
# OpenAI options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# HuggingFace options: sentence-transformers/all-MiniLM-L6-v2, sentence-transformers/all-mpnet-base-v2
EMBEDDING_MODEL=text-embedding-3-small

# ----- Vector Store Configuration -----
# Backend to use for vector storage
# Options: chroma | faiss
VECTOR_STORE_BACKEND=chroma

# ChromaDB settings (used when VECTOR_STORE_BACKEND=chroma)
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=rag_collection

# FAISS settings (used when VECTOR_STORE_BACKEND=faiss)
FAISS_PERSIST_DIR=./faiss_db
# Dimension must match the embedding model output:
#   text-embedding-3-small  → 1536
#   text-embedding-3-large  → 3072
#   all-MiniLM-L6-v2        → 384
FAISS_DIMENSION=1536

# ----- Document Ingestion Settings -----
# Directory containing source documents for ingestion
DOCS_DIR=./data/documents

# Chunking strategy: fixed_size | sentence_aware | sliding_window
CHUNKING_STRATEGY=sentence_aware

# Target chunk size in tokens (approx. words)
CHUNK_SIZE=400

# Overlap between consecutive chunks in tokens
CHUNK_OVERLAP=80

# ----- Query Settings -----
# Number of top-K chunks to retrieve per query
TOP_K=5

# ----- Logging -----
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
